# HackNotify Autopilot — Environment Variables
# Copy this file to .env and fill in values.
# NEVER commit .env with real credentials.

# Supabase project URL (e.g. https://xxxx.supabase.co)
SUPABASE_URL=

# Supabase service-role key — server-side only, NEVER expose to frontend
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key (from Google AI Studio: https://aistudio.google.com/)
# Required for AI opportunity extraction and classification
GEMINI_API_KEY=

# Gemini model identifier (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Application environment: development | production | test
NODE_ENV=development
