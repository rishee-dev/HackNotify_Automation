{
  "name": "hacknotify-autopilot",
  "version": "0.1.0",
  "description": "HackNotify Autopilot — Backend automation platform for HackNotify India opportunity processing pipeline",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "analyze:test": "tsx src/cli/analyze-fixture.ts",
    "ingest:test": "tsx src/cli/ingest-fixture.ts",
    "ingest:fixtures": "tsx src/cli/ingest-fixture.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "hacknotify",
    "automation",
    "supabase",
    "typescript"
  ],
  "license": "UNLICENSED",
  "dependencies": {
    "@google/genai": "^2.17.1",
    "@supabase/supabase-js": "^2.112.0",
    "dotenv": "^16.4.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.2.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
